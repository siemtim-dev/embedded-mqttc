# Example environment file for the embassy-rp-mqtt example.
# This .env.example provides placeholder variable names and sample values to show how the runtime .env should be structured.
# It is not used directly by the application; copy or rename this file to `.env` and replace the placeholders with real values (credentials, hostnames, ports, client IDs, topic names, certificates, etc.).
# Keep secrets out of version control: commit this example file, but ensure your real `.env` is listed in .gitignore.
# Use the populated `.env` at runtime (or export the variables into the environment) so the application can read configuration values.
# Update values here only as documentation/template; changes to this file do not affect deployed runs until mirrored in the active `.env`.

MQTT_HOST=my-mqtt-broker.local # required, hostname of the MQTT broker
MQTT_PORT=1883 # optional, defaults to 1883 if not set
MQTT_CLIENT_ID=any-client-id # required, unique client ID for the MQTT connection
MQTT_USERNAME=user123 # optional, remove if no authentication is needed
MQTT_PASSWORD=password1234 # required if MQTT_USERNAME is set

MQTT_SUBSCIBE_TO=test/topic/receive # required, topic the example subscribed to
MQTT_PUBLISH_TO=test/topic/send # required, topic the example publishes to

WIFI_SSID=MyCoolWiFi # required, SSID of the WiFi network to connect to
WIFI_PASSWORD=i-am-very-secret # required, password for the WiFi network